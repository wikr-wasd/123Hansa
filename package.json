{
  "name": "123hansa",
  "version": "2.0.0",
  "description": "123Hansa — marknadsplats för företagsaffärer i Sverige, Norge, Danmark, Kroatien och Bosnien",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@123hansa/web",
    "dev:api": "npm run dev --workspace=@123hansa/api",
    "build": "npm run build:core && npm run build:web && npm run build:api",
    "build:core": "npm run type-check --workspace=@hansa/core",
    "build:web": "npm run build --workspace=@123hansa/web",
    "build:api": "npm run build --workspace=@123hansa/api",
    "test": "npm run test:core && npm run test:web && npm run test:api",
    "test:core": "npm run test --workspace=@hansa/core",
    "test:web": "npm run test --workspace=@123hansa/web -- --run",
    "test:api": "npm run test --workspace=@123hansa/api",
    "test:db": "supabase test db",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run type-check && npm run lint && npm run test && npm run build",
    "db:start": "supabase start -x imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "keywords": [
    "marketplace",
    "business",
    "m&a",
    "sweden",
    "norway",
    "denmark",
    "croatia",
    "bosnia"
  ],
  "author": "123Hansa",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "supabase": "2.117.0"
  }
}
