# Vad Vercel inte behöver för att bygga webben.
#
# Listan var tidigare full av filer som inte finns längre — 30 MD-filer,
# demoservrar och tre parallella vercel-konfigurationer. De togs bort ur repot
# 2026-09-17.

node_modules/
apps/*/node_modules/
packages/*/node_modules/

# Byggartefakter
apps/web/dist/
*.tsbuildinfo
apps/web/coverage/

# Lokalt
*.log
.env
.env.*
.DS_Store
Thumbs.db

# Databasen driftsätts med Supabase CLI, inte av Vercel
supabase/

# Dokumentationen behövs inte i bygget
docs/
*.md
