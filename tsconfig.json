{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },

  // Rotconfigen är en BAS som apps/api ärver — den kompilerar inget själv.
  // Tidigare stod här "include": ["**/*.ts", "**/*.tsx"], vilket drog in hela
  // trädet med Node-lib men utan DOM och gav 25 960 typfel i CI.
  // Varje workspace äger sin egen include.
  "files": []
}
